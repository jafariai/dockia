# ---- Core ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. Use the hostname(s) / IP the platform is served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public origin(s) of the frontend, used for CORS + CSRF trusted origins.
# Must include the scheme and port the browser actually uses.
FRONTEND_ORIGIN=https://localhost:8443

# ---- Database ----
POSTGRES_DB=dockia
POSTGRES_USER=dockia
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- JWT ----
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Login lockout (per account, on top of the per-IP throttle) ----
# LOGIN_LOCKOUT_THRESHOLD=10
# LOGIN_LOCKOUT_SECONDS=900

# ---- Storage ----
# local | s3
STORAGE_BACKEND=local
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Reverse proxy ----
# The only port published to the host. nginx terminates TLS here.
HTTPS_PORT=8443
# Enable only once a CA-trusted certificate is in place.
# SECURE_HSTS_SECONDS=31536000

# ---- Frontend ----
# Browser talks to the API through nginx at the same origin.
NEXT_PUBLIC_API_URL=/api

# ---- Web push (optional) ----
# A VAPID keypair is generated and stored in Redis on first use. Set these only
# to pin your own.
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ---- Bootstrap admin (used once by the seed command) ----
ADMIN_EMAIL=admin@team.internal
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin
